title: Home
views:
  - path: default_view
    title: Home
    cards:
      - type: entities
        entities:
          - entity: switch.piec_pompka_socket_1
            name: Piec pompka
          - entity: sensor.piec_pompka_power_2
            name: Piec pompka Power
          - entity: switch.bojler_grzalka_socket_1
            name: Bojler grzałka
          - entity: sensor.bojler_grzalka_power
          - entity: switch.furnace_tri_valve_switch_1
            name: kaloryfery <-> bojler
            icon: mdi:pipe-valve
            secondary_info: shshs
        title: Kotłownia
        state_color: true
        show_header_toggle: false
      - type: entities
        entities:
          - entity: sensor.tasmota_ds18b20_1_temperature
            name: Piec
          - entity: sensor.tasmota_ds18b20_2_temperature
            name: Bojler
          - entity: sensor.esp3_rssi
            name: signal strength
        title: Kotłownia czujniki
      - type: entities
        entities:
          - entity: sensor.temperature_humidity_sensor_4be2_temperature
            name: Temp
          - entity: sensor.temperature_humidity_sensor_4be2_humidity
            name: Humidity
        title: Salon
      - type: weather-forecast
        entity: weather.home
        show_forecast: false
      - type: entities
        entities:
          - entity: switch.lampki_przod_socket
          - entity: switch.gniazdko_1_socket
            name: '1'
          - entity: switch.smart_plug_socket_1
            name: '3'
          - entity: switch.1_garaz_3_5kw_socket_1
            name: 3d printer drier
        title: Gniazdka
        show_header_toggle: false
    badges: []
    visible:
      - user: USER_ID_1
      - user: USER_ID_2
      - user: USER_ID_3
  - type: sections
    path: electricity
    max_columns: 4
    title: Electricity
    icon: mdi:lightning-bolt
    sections:
      - type: grid
        cards:
          - type: heading
            heading: PV ⚡
            heading_style: title
          - type: entities
            entities:
              - entity: sensor.solax_current
                secondary_info: last-updated
              - entity: sensor.solax_yieldtoday
                secondary_info: last-updated
              - entity: sensor.solax_yieldtotal
                secondary_info: last-updated
            show_header_toggle: true
            state_color: false
      - type: grid
        cards:
          - type: heading
            heading: Usage ⚡
            heading_style: title
          - type: entities
            entities:
              - entity: sensor.phase_a_voltage
                name: Volt A
                secondary_info: last-updated
              - entity: sensor.phase_b_voltage
                name: Volt B
              - entity: sensor.phase_c_voltage
                name: Volt C
              - entity: sensor.phase_a_power
                name: Power A
              - entity: sensor.phase_b_power
                name: Power B
              - entity: sensor.phase_c_power
                name: Power C
              - entity: sensor.total_power
            show_header_toggle: false
            state_color: false
    cards: []
  - type: sections
    max_columns: 4
    title: Media
    path: media
    sections:
      - type: grid
        cards:
          - type: heading
            heading: New section
          - type: grid
            square: false
            columns: 1
            cards:
              - type: entities
                entities:
                  - entity: light.dreamview_t1_2
                title: Living Room
              - type: media-control
                entity: media_player.samsung_q70_series_55
    cards: []
    visible:
      - user: af7f18fb9cbc49d499f5ba37ac8591f8
      - user: 322b6d9102be47bcbe3d1ebad5fa18a3
      - user: 11a531b072374fee94cebd24a8bd7369
  - type: sections
    max_columns: 4
    title: Sauna
    path: sauna
    sections:
      - type: grid
        cards:
          - type: thermostat
            entity: climate.sauna_xiao_c6_sauna
          - type: custom:button-card
            entity: climate.sauna_xiao_c6_sauna
            show_name: true
            show_icon: true
            name: Start / Stop
            icon: |
              [[[
                if (entity.state === 'heat')
                  return 'mdi:radiator';
                return 'mdi:radiator-off';
              ]]]
            styles:
              card:
                - height: 120px
              icon:
                - color: |
                    [[[
                      if (entity.state === 'heat')
                        return 'orange';
                      return 'gray';
                    ]]]
            tap_action:
              action: call-service
              service: button.press
              service_data:
                entity_id: button.sauna_xiao_c6_sauna_mode_button
            show_state: false
          - type: entities
            title: Status
            entities:
              - entity: sensor.sauna_xiao_c6_sauna_temp
                name: Current Temp
                icon: mdi:thermometer
              - entity: sensor.sauna_xiao_c6_sauna_minutes_on
                name: Runtime
                icon: mdi:timer-outline
      - type: grid
        cards:
          - type: heading
            heading_style: title
            heading: Power
          - show_name: true
            show_icon: true
            type: button
            entity: switch.gniazdko_3_5kw_piec_socket_1
            icon: mdi:power-cycle
            name: Main switch
            color: green
            show_state: true
